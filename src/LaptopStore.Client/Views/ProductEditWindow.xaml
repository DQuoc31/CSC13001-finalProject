<Window x:Class="LaptopStore.Client.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Thông Tin Sản Phẩm" Height="680" Width="680"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" Text="➕ Thêm Sản Phẩm Mới" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Nhập đầy đủ thông tin kỹ thuật laptop/linh kiện phần cứng bên dưới" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Scrollable Form Inputs -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <!-- Dòng 1: Tên sản phẩm -->
                <TextBlock Text="Tên sản phẩm (*):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtName" Padding="8,6" Margin="0,0,0,12" FontSize="13"/>

                <!-- Dòng 2: Mã SKU & Hãng sản xuất -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Mã SKU (*):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtSku" Padding="8,6" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Hãng sản xuất (*):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtBrand" Padding="8,6" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <!-- Dòng 3: Danh mục & Model -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Danh mục (*):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CboCategory" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="8,6" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Model:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtModel" Padding="8,6" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <!-- Dòng 4: Giá bán & Giá vốn -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Giá bán niêm yết (VNĐ) (*):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPrice" Padding="8,6" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Giá vốn nhập kho (VNĐ):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtCostPrice" Padding="8,6" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <!-- Dòng 5: Số lượng tồn kho & Tồn tối thiểu & Bảo hành -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Số lượng tồn:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtStock" Text="10" Padding="8,6" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Cảnh báo tồn tối thiểu:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtMinStock" Text="3" Padding="8,6" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Bảo hành (tháng):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtWarranty" Text="24" Padding="8,6" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,4,0,12"/>
                <TextBlock Text="⚙️ CẤU HÌNH PHẦN CỨNG CHI TIẾT" FontWeight="Bold" FontSize="13" Foreground="#2563EB" Margin="0,0,0,8"/>

                <!-- Cấu hình CPU & RAM -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Vi xử lý (CPU):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtCpu" Padding="8,6" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Bộ nhớ RAM:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtRam" Padding="8,6" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <!-- Cấu hình Ổ cứng & Card đồ họa -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ổ cứng lưu trữ (SSD):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtStorage" Padding="8,6" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Card đồ họa (GPU):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtGpu" Padding="8,6" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <!-- Màn hình & Hệ điều hành -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Kích thước màn hình:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtScreen" Padding="8,6" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Hệ điều hành:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtOs" Padding="8,6" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <!-- Mô tả thêm -->
                <TextBlock Text="Mô tả tóm tắt:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDescription" Height="55" TextWrapping="Wrap" AcceptsReturn="True" Padding="8,6" FontSize="12" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy bỏ" Padding="16,8" Margin="0,0,8,0" Background="#E2E8F0" Foreground="#334155"
                        BorderThickness="0" FontWeight="SemiBold" Click="CancelButton_Click"/>
                <Button Content="💾 Lưu Sản Phẩm" Padding="20,8" Background="#2563EB" Foreground="White"
                        BorderThickness="0" FontWeight="Bold" Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="LaptopStore.Client.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Thông Tin Sản Phẩm" Height="760" Width="680"
        WindowStartupLocation="CenterOwner" Background="White" ResizeMode="NoResize"
        FontFamily="{StaticResource Font.Text}" FontSize="13" Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" Text="Thêm Sản Phẩm Mới" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Nhập đầy đủ thông tin kỹ thuật laptop/linh kiện phần cứng bên dưới" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Scrollable Form Inputs -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <!-- Dòng 1: Tên sản phẩm -->
                <TextBlock Text="Tên sản phẩm (*):" Style="{StaticResource Text.Label}"/>
                <TextBox x:Name="TxtName" Margin="0,0,0,12"/>

                <!-- Dòng 2: Mã SKU & Hãng sản xuất -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Mã SKU (*):" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="TxtSku"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Hãng sản xuất (*):" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="TxtBrand"/>
                    </StackPanel>
                </Grid>

                <!-- Dòng 3: Danh mục & Model -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Danh mục (*):" Style="{StaticResource Text.Label}"/>
                        <ComboBox x:Name="CboCategory" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Model:" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="TxtModel"/>
                    </StackPanel>
                </Grid>

                <!-- Dòng 4: Giá bán & Giá vốn -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Giá bán niêm yết (VNĐ) (*):" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="TxtPrice"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Giá vốn nhập kho (VNĐ):" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="TxtCostPrice"/>
                    </StackPanel>
                </Grid>

                <!-- Dòng 5: Số lượng tồn kho & Tồn tối thiểu & Bảo hành -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Số lượng tồn:" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="TxtStock" Text="10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Cảnh báo tồn tối thiểu:" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="TxtMinStock" Text="3"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Bảo hành (tháng):" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="TxtWarranty" Text="24"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,4,0,12"/>
                <TextBlock Text="⚙️ CẤU HÌNH PHẦN CỨNG CHI TIẾT" FontWeight="Bold" FontSize="13" Foreground="#2563EB" Margin="0,0,0,8"/>

                <!-- Cấu hình CPU & RAM -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Vi xử lý (CPU):" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="TxtCpu"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Bộ nhớ RAM:" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="TxtRam"/>
                    </StackPanel>
                </Grid>

                <!-- Cấu hình Ổ cứng & Card đồ họa -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ổ cứng lưu trữ (SSD):" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="TxtStorage"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Card đồ họa (GPU):" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="TxtGpu"/>
                    </StackPanel>
                </Grid>

                <!-- Màn hình & Hệ điều hành -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Kích thước màn hình:" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="TxtScreen"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Hệ điều hành:" Style="{StaticResource Text.Label}"/>
                        <TextBox x:Name="TxtOs"/>
                    </StackPanel>
                </Grid>

                <!-- Mô tả thêm -->
                <TextBlock Text="Mô tả tóm tắt:" Style="{StaticResource Text.Label}"/>
                <TextBox x:Name="TxtDescription" Height="55" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy bỏ" Margin="0,0,8,0" MinWidth="96" Click="CancelButton_Click"/>
                <Button Style="{StaticResource Btn.Primary}" Content="Lưu Sản Phẩm" MinWidth="140" Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

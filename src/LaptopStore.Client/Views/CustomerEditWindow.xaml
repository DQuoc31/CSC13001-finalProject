<Window x:Class="LaptopStore.Client.Views.CustomerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Thông Tin Khách Hàng" Height="520" Width="500"
        WindowStartupLocation="CenterOwner" Background="White" ResizeMode="NoResize"
        FontFamily="{StaticResource Font.Text}" FontSize="13" Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <TextBlock x:Name="TxtTitle" Text="Thêm Khách Hàng Mới" FontSize="17" FontWeight="Bold" Foreground="#1E293B"/>
        </Border>

        <!-- Form Inputs -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Họ và tên khách hàng (*):" Style="{StaticResource Text.Label}"/>
            <TextBox x:Name="TxtFullName" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Số điện thoại (*):" Style="{StaticResource Text.Label}"/>
                    <TextBox x:Name="TxtPhone"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Địa chỉ Email:" Style="{StaticResource Text.Label}"/>
                    <TextBox x:Name="TxtEmail"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Địa chỉ giao hàng / cư trú:" Style="{StaticResource Text.Label}"/>
            <TextBox x:Name="TxtAddress" Margin="0,0,0,12"/>

            <TextBlock Text="Ghi chú thêm:" Style="{StaticResource Text.Label}"/>
            <TextBox x:Name="TxtNote" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>

        <!-- Buttons -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy bỏ" Margin="0,0,8,0" MinWidth="96" Click="CancelButton_Click"/>
                <Button Style="{StaticResource Btn.Primary}" Content="Lưu Khách Hàng" MinWidth="140" Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

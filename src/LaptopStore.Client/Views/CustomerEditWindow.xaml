<Window x:Class="LaptopStore.Client.Views.CustomerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Thông Tin Khách Hàng" Height="420" Width="500"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <TextBlock x:Name="TxtTitle" Text="➕ Thêm Khách Hàng Mới" FontSize="17" FontWeight="Bold" Foreground="#1E293B"/>
        </Border>

        <!-- Form Inputs -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Họ và tên khách hàng (*):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtFullName" Padding="8,6" Margin="0,0,0,12" FontSize="13"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Số điện thoại (*):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPhone" Padding="8,6" FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Địa chỉ Email:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtEmail" Padding="8,6" FontSize="13"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Địa chỉ giao hàng / cư trú:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtAddress" Padding="8,6" Margin="0,0,0,12" FontSize="13"/>

            <TextBlock Text="Ghi chú thêm:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtNote" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Padding="8,6" FontSize="13"/>
        </StackPanel>

        <!-- Buttons -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy bỏ" Padding="16,6" Margin="0,0,8,0" Background="#E2E8F0" Foreground="#334155"
                        BorderThickness="0" FontWeight="SemiBold" Click="CancelButton_Click"/>
                <Button Content="💾 Lưu Khách Hàng" Padding="20,6" Background="#2563EB" Foreground="White"
                        BorderThickness="0" FontWeight="Bold" Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

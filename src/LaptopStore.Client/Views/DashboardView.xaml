<UserControl x:Class="LaptopStore.Client.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề & Nút tải lại -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="📊 Tổng Quan Kinh Doanh &amp; Báo Cáo" FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>
            <Button Content="🔄 Tải lại dữ liệu" HorizontalAlignment="Right" Padding="12,6"
                    Background="#3B82F6" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                    Command="{Binding RefreshCommand}"/>
        </DockPanel>

        <!-- Thẻ KPI thống kê nhanh -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,24">
            <!-- Doanh thu tổng -->
            <Border Background="#EFF6FF" CornerRadius="8" Padding="16" Margin="6" BorderBrush="#BFDBFE" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Tổng Doanh Thu" FontSize="13" Foreground="#1E40AF"/>
                    <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N0} đ}" FontSize="20" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,8,0,4"/>
                    <TextBlock Text="Đã hoàn tất thanh toán" FontSize="11" Foreground="#64748B"/>
                </StackPanel>
            </Border>

            <!-- Doanh thu tháng này -->
            <Border Background="#ECFDF5" CornerRadius="8" Padding="16" Margin="6" BorderBrush="#A7F3D0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Doanh Thu Tháng Này" FontSize="13" Foreground="#065F46"/>
                    <TextBlock Text="{Binding MonthRevenue, StringFormat={}{0:N0} đ}" FontSize="20" FontWeight="Bold" Foreground="#047857" Margin="0,8,0,4"/>
                    <TextBlock Text="Tháng hiện tại" FontSize="11" Foreground="#64748B"/>
                </StackPanel>
            </Border>

            <!-- Tổng số đơn hàng -->
            <Border Background="#FDF4FF" CornerRadius="8" Padding="16" Margin="6" BorderBrush="#F5D0FE" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Tổng Đơn Hàng" FontSize="13" Foreground="#86198F"/>
                    <TextBlock Text="{Binding TotalOrders}" FontSize="20" FontWeight="Bold" Foreground="#701A75" Margin="0,8,0,4"/>
                    <TextBlock Text="{Binding CompletedOrders, StringFormat={}Đã hoàn tất: {0}}" FontSize="11" Foreground="#64748B"/>
                </StackPanel>
            </Border>

            <!-- Cảnh báo tồn kho -->
            <Border Background="#FFFBEB" CornerRadius="8" Padding="16" Margin="6" BorderBrush="#FDE68A" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Cảnh Báo Tồn Kho Thấp" FontSize="13" Foreground="#92400E"/>
                    <TextBlock Text="{Binding LowStockCount, StringFormat={}{0} máy}" FontSize="20" FontWeight="Bold" Foreground="#B45309" Margin="0,8,0,4"/>
                    <TextBlock Text="Cần lập phiếu nhập kho" FontSize="11" Foreground="#64748B"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Danh sách Top sản phẩm bán chạy -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="🏆 Top 5 Sản Phẩm Bán Chạy Nhất" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding TopSellingProducts}" AutoGenerateColumns="False"
                          IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          Background="White" RowHeight="36">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã SP" Binding="{Binding ProductId}" Width="80"/>
                        <DataGridTextColumn Header="Tên Laptop / Linh kiện" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Hãng" Binding="{Binding Brand}" Width="120"/>
                        <DataGridTextColumn Header="Số Lượng Bán" Binding="{Binding TotalQuantitySold}" Width="140"/>
                        <DataGridTextColumn Header="Doanh Thu Đem Lại" Binding="{Binding TotalRevenue, StringFormat={}{0:N0} đ}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

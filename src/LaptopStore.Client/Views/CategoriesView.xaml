<UserControl x:Class="LaptopStore.Client.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:LaptopStore.Client.Controls"
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1150">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <DockPanel Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Danh mục" Style="{StaticResource Text.H1}"/>
                <TextBlock Style="{StaticResource Text.Sub}">
                    <Run Text="{Binding Categories.Count, Mode=OneWay}"/><Run Text=" nhóm thiết bị · Chọn một thẻ để sửa hoặc xóa, nhấp đúp để sửa nhanh"/>
                </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Tải lại" ctl:Ui.Icon="{StaticResource Icon.Refresh}" Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="Sửa" ctl:Ui.Icon="{StaticResource Icon.Edit}" Command="{Binding EditCategoryCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Btn.Danger}" Content="Xóa" ctl:Ui.Icon="{StaticResource Icon.Trash}" Command="{Binding DeleteCategoryCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Btn.Primary}" Content="Thêm danh mục" ctl:Ui.Icon="{StaticResource Icon.Plus}" Command="{Binding AddCategoryCommand}"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                     Margin="-8" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCategoryCommand}"/>
                </ListBox.InputBindings>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Bd" Style="{StaticResource Card}" Margin="8" Padding="18">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Border Width="42" Height="42" CornerRadius="12" Background="{Binding Name, Converter={StaticResource ThumbBrush}, ConverterParameter=bg}">
                                        <ctl:Icon Data="{StaticResource Icon.Folder}" Width="20" Height="20"
                                                  Foreground="{Binding Name, Converter={StaticResource ThumbBrush}, ConverterParameter=fg}"/>
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Tag}" Margin="0">
                                        <TextBlock Text="{Binding DisplayOrder, StringFormat=Thứ tự {0}}" FontSize="11.5" Foreground="{StaticResource Brush.Muted}"/>
                                    </Border>
                                </DockPanel>
                                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Line2}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ctl:Icon Data="{StaticResource Icon.Laptop}" Width="15" Height="15" Foreground="{StaticResource Brush.Accent}" Margin="0,0,7,0"/>
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding ProductCount, Mode=OneWay}"/><Run Text=" sản phẩm" FontWeight="Normal" Foreground="{StaticResource Brush.Muted}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Slug}" Style="{StaticResource Text.Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                    </DockPanel>
                                </Border>
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Description, TargetNullValue='Chưa có mô tả'}" Style="{StaticResource Text.Muted}" FontSize="12.5"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="38" Margin="0,4,0,0" LineHeight="19"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#BFDBFE"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Padding" Value="17"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Style="{StaticResource EmptyState}"
                        Visibility="{Binding Categories.Count, Converter={StaticResource Vis}, ConverterParameter=invert}">
                <ctl:Icon Data="{StaticResource Icon.Folder}" Width="30" Height="30" Foreground="{StaticResource Brush.Faint}"/>
                <TextBlock Text="Chưa có danh mục nào" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

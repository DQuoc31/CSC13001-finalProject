<UserControl x:Class="LaptopStore.Client.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề & Thao tác nhanh -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="📁 Quản Lý Danh Mục Sản Phẩm" FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Phân nhóm thiết bị laptop, linh kiện và phụ kiện" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="➕ Thêm Danh Mục" Padding="14,6" Margin="4,0" Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="Bold"
                        Command="{Binding AddCategoryCommand}"/>
                <Button Content="✏️ Sửa Danh Mục" Padding="14,6" Margin="4,0" Background="#3B82F6" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                        Command="{Binding EditCategoryCommand}"/>
                <Button Content="🗑️ Xóa Danh Mục" Padding="12,6" Margin="4,0" Background="#EF4444" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                        Command="{Binding DeleteCategoryCommand}"/>
                <Button Content="🔄 Tải lại" Padding="12,6" Margin="4,0" Background="#F1F5F9" BorderThickness="1" BorderBrush="#CBD5E1"
                        Command="{Binding LoadCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- Bảng danh sách danh mục -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" Background="White" RowHeight="42">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã ID" Binding="{Binding Id}" Width="80"/>
                <DataGridTextColumn Header="Tên Danh Mục" Binding="{Binding Name}" Width="220" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Đường Dẫn Slug" Binding="{Binding Slug}" Width="180"/>
                <DataGridTextColumn Header="Thứ Tự" Binding="{Binding DisplayOrder}" Width="80"/>
                <DataGridTextColumn Header="Số Lượng Sản Phẩm" Binding="{Binding ProductCount, StringFormat={}{0} máy/linh kiện}" Width="160"/>
                <DataGridTextColumn Header="Mô Tả Chi Tiết" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

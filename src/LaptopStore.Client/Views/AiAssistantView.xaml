<UserControl x:Class="LaptopStore.Client.Views.AiAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🤖 Trợ Lý AI Nghiệp Vụ Thông Minh" FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Hỗ trợ RBAC &amp; Tích hợp dữ liệu thời gian thực" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#64748B"/>
        </DockPanel>

        <!-- Thanh nút câu hỏi gợi ý nhanh -->
        <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
            <WrapPanel>
                <TextBlock Text="💡 Câu hỏi mẫu nhanh:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0"/>
                <Button Content="📊 Báo cáo doanh thu tháng" Margin="4,2" Padding="8,4" Background="#E0E7FF" Foreground="#3730A3" BorderThickness="0"
                        Command="{Binding QuickPromptCommand}" CommandParameter="Doanh thu tháng này của cửa hàng là bao nhiêu?"/>
                <Button Content="⚠️ Sản phẩm sắp hết hàng" Margin="4,2" Padding="8,4" Background="#FEF3C7" Foreground="#92400E" BorderThickness="0"
                        Command="{Binding QuickPromptCommand}" CommandParameter="Sản phẩm nào trong kho đang sắp hết hàng?"/>
                <Button Content="💻 Tư vấn laptop 25 triệu" Margin="4,2" Padding="8,4" Background="#DCFCE7" Foreground="#166534" BorderThickness="0"
                        Command="{Binding QuickPromptCommand}" CommandParameter="Tư vấn cho tôi laptop khoảng 25 triệu để lập trình và học tập."/>
                <Button Content="🎮 Laptop gaming 35 triệu" Margin="4,2" Padding="8,4" Background="#FCE7F3" Foreground="#9D174D" BorderThickness="0"
                        Command="{Binding QuickPromptCommand}" CommandParameter="Gợi ý laptop gaming tầm 35 triệu card rời khỏe."/>
            </WrapPanel>
        </Border>

        <!-- Khung hiển thị cuộc trò chuyện (Chat Stream) -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12" Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,6" Padding="12,10" CornerRadius="8" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAi}" Value="true">
                                                <Setter Property="Background" Value="#F0FDF4"/>
                                                <Setter Property="BorderBrush" Value="#BBF7D0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Sender}" FontWeight="Bold" FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#2563EB"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAi}" Value="true">
                                                            <Setter Property="Foreground" Value="#16A34A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm:ss}}" HorizontalAlignment="Right" FontSize="11" Foreground="#94A3B8"/>
                                    </DockPanel>

                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" Foreground="#1E293B" LineHeight="20"/>

                                    <TextBlock Text="{Binding ToolInfo}" Margin="0,6,0,0" FontSize="11" Foreground="#64748B" FontStyle="Italic"
                                               Visibility="{Binding ToolInfo, Converter={x:Null}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Ô nhập câu hỏi & Nút Gửi -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding UserPrompt, UpdateSourceTrigger=PropertyChanged}"
                     Padding="12,8" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,10,0"/>

            <Button Grid.Column="1" Content="Gửi Câu Hỏi 🚀" Background="#2563EB" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0"
                    Command="{Binding SendMessageCommand}"/>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="LaptopStore.Client.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:LaptopStore.Client.Controls"
             mc:Ignorable="d" d:DesignHeight="780" d:DesignWidth="1150">
    <UserControl.Resources>
        <!-- Thẻ sản phẩm bấm để thêm vào giỏ -->
        <Style x:Key="ProductCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" CornerRadius="14" Padding="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsInCart}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Padding" Value="11"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepBtn" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Chọn sản phẩm ============ -->
        <Border Style="{StaticResource Card}" ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,14,16,8" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Bán hàng tại quầy" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     ctl:Ui.Icon="{StaticResource Icon.Search}" ctl:Ui.Placeholder="Tìm laptop, linh kiện theo tên, SKU, hãng…"/>
                        </DockPanel>
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                 DisplayMemberPath="Name"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ProductCard}"
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Bấm để thêm vào giỏ">
                                        <StackPanel>
                                            <Grid Height="78" Margin="0,0,0,10">
                                                <Border CornerRadius="10" Background="{Binding Product.Brand, Converter={StaticResource ThumbBrush}, ConverterParameter=bg}">
                                                    <ctl:Icon Data="{StaticResource Icon.Laptop}" Width="36" Height="36" StrokeThickness="1.3"
                                                              Foreground="{Binding Product.Brand, Converter={StaticResource ThumbBrush}, ConverterParameter=fg}"/>
                                                </Border>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" CornerRadius="8" Padding="7,2"
                                                        Background="{StaticResource Brush.Accent}" Visibility="{Binding IsInCart, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="{Binding InCart, StringFormat=× {0}}" Foreground="White" FontWeight="Bold" FontSize="11.5"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"
                                                       Height="34" TextTrimming="CharacterEllipsis" LineHeight="17"/>
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock Text="{Binding Product.Price, StringFormat={}{0:N0} đ}" FontWeight="Bold" Foreground="{StaticResource Brush.AccentInk}"/>
                                                <TextBlock HorizontalAlignment="Right" FontSize="11.5"
                                                           Foreground="{Binding Product, Converter={StaticResource StockBar}, ConverterParameter=brush}"
                                                           Text="{Binding Product.StockQuantity, StringFormat=Còn {0}}"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Style="{StaticResource EmptyState}"
                                Visibility="{Binding Products.Count, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <ctl:Icon Data="{StaticResource Icon.Search}" Width="30" Height="30" Foreground="{StaticResource Brush.Faint}"/>
                        <TextBlock Text="Không có sản phẩm phù hợp" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============ Giỏ hàng ============ -->
        <Border Grid.Column="2" Style="{StaticResource Card}" ClipToBounds="True">
            <DockPanel>
                <!-- Đầu giỏ -->
                <StackPanel DockPanel.Dock="Top" Margin="18,16,18,12">
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Đơn hàng mới" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource Btn.Link}" Content="Xóa tất cả" Foreground="{StaticResource Brush.Bad}" HorizontalAlignment="Right"
                                Command="{Binding ClearCartCommand}"/>
                    </DockPanel>
                    <TextBlock Text="Khách hàng" Style="{StaticResource Text.Label}"/>
                    <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" ctl:Ui.Placeholder="Chọn khách hàng"
                              MinHeight="42" Padding="10,0,34,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Width="24" Height="24" Content="{Binding FullName}" ContentTemplate="{StaticResource AvatarTemplate}" Margin="0,0,9,0"/>
                                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PhoneNumber, StringFormat=  ·  {0}}" Foreground="{StaticResource Brush.Muted}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Thanh toán -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Surface2}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,14,14" Padding="18,14,18,18">
                    <StackPanel>
                        <TextBlock Text="Thanh toán" Style="{StaticResource Text.Label}"/>
                        <UniformGrid Columns="2" Margin="-4,0,-4,10">
                            <RadioButton Style="{StaticResource OptionTile}" GroupName="Pay" Margin="4" Content="Tiền mặt"
                                         ctl:Ui.Icon="{StaticResource Icon.Cash}" IsChecked="{Binding IsCash, Mode=TwoWay}"/>
                            <RadioButton Style="{StaticResource OptionTile}" GroupName="Pay" Margin="4" Content="Chuyển khoản"
                                         ctl:Ui.Icon="{StaticResource Icon.Bank}" IsChecked="{Binding IsBankTransfer, Mode=TwoWay}"/>
                            <RadioButton Style="{StaticResource OptionTile}" GroupName="Pay" Margin="4" Content="Thẻ"
                                         ctl:Ui.Icon="{StaticResource Icon.Card}" IsChecked="{Binding IsCard, Mode=TwoWay}"/>
                            <RadioButton Style="{StaticResource OptionTile}" GroupName="Pay" Margin="4" Content="Trả góp 0%"
                                         ctl:Ui.Icon="{StaticResource Icon.Clock}" IsChecked="{Binding IsInstallment, Mode=TwoWay}"/>
                        </UniformGrid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" ctl:Ui.Icon="{StaticResource Icon.Tag}"
                                     ctl:Ui.Placeholder="Giảm giá" ToolTip="Giảm giá (VNĐ)"/>
                            <TextBox Grid.Column="2" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" ctl:Ui.Icon="{StaticResource Icon.Edit}"
                                     ctl:Ui.Placeholder="Ghi chú / địa chỉ giao (nếu có)"/>
                        </Grid>

                        <DockPanel Margin="0,2">
                            <TextBlock Foreground="{StaticResource Brush.Muted}">
                                <Run Text="Tạm tính ("/><Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=" sản phẩm)"/>
                            </TextBlock>
                            <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0} đ}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="Giảm giá" Foreground="{StaticResource Brush.Muted}"/>
                            <TextBlock Text="{Binding DiscountAmount, StringFormat=− {0:N0} đ}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Ok}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Margin="0,8,0,14" Padding="0,10,0,0">
                            <DockPanel>
                                <TextBlock Text="Khách cần trả" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FinalAmount, StringFormat={}{0:N0} đ}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.AccentInk}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Border>
                        <Button Style="{StaticResource Btn.Primary}" Height="48" FontSize="14.5" Content="Xác nhận thanh toán"
                                ctl:Ui.Icon="{StaticResource Icon.Check}" Command="{Binding CheckoutCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Thông báo -->
                <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,12">
                    <Border Background="{StaticResource Brush.BadSoft}" CornerRadius="10" Padding="12,9"
                            Visibility="{Binding Warning, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <ctl:Icon Data="{StaticResource Icon.Alert}" Width="15" Height="15" Foreground="{StaticResource Brush.BadInk}" Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding Warning}" Foreground="{StaticResource Brush.BadInk}" FontSize="12.5" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                    <Border Background="{StaticResource Brush.OkSoft}" CornerRadius="10" Padding="12,9"
                            Visibility="{Binding SuccessMessage, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <ctl:Icon Data="{StaticResource Icon.Check}" Width="15" Height="15" Foreground="{StaticResource Brush.OkInk}" Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource Brush.OkInk}" FontSize="12.5" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Danh sách trong giỏ -->
                <Grid>
                    <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Cart}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Brush.Line2}" BorderThickness="0,0,0,1" Padding="18,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Width="36" Height="36" Content="{Binding Product.Brand}" ContentTemplate="{StaticResource ThumbTemplate}" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SubTotal, StringFormat={}{0:N0} đ}" Style="{StaticResource Text.Muted}"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" CornerRadius="8" Margin="8,0,4,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Style="{StaticResource StepBtn}" ctl:Ui.Icon="{StaticResource Icon.Minus}"
                                                                Command="{Binding DataContext.DecreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                        <TextBlock Text="{Binding Quantity}" FontWeight="SemiBold" Width="24" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <Button Style="{StaticResource StepBtn}" ctl:Ui.Icon="{StaticResource Icon.Plus}"
                                                                Command="{Binding DataContext.IncreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Button Grid.Column="3" Style="{StaticResource StepBtn}" ctl:Ui.Icon="{StaticResource Icon.X}" ToolTip="Bỏ khỏi giỏ"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <StackPanel Style="{StaticResource EmptyState}"
                                Visibility="{Binding Cart.Count, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <ctl:Icon Data="{StaticResource Icon.Cart}" Width="30" Height="30" Foreground="{StaticResource Brush.Faint}"/>
                        <TextBlock Text="Giỏ hàng trống" FontWeight="SemiBold" Margin="0,10,0,2" HorizontalAlignment="Center"/>
                        <TextBlock Text="Bấm vào sản phẩm bên trái để thêm." Style="{StaticResource Text.Muted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

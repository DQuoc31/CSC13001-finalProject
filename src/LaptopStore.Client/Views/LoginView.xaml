<UserControl x:Class="LaptopStore.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctl="clr-namespace:LaptopStore.Client.Controls"
             mc:Ignorable="d" d:DesignHeight="860" d:DesignWidth="1440">
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
    </UserControl.InputBindings>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel giới thiệu -->
        <Grid Grid.Column="0" ClipToBounds="True" Background="#0B1120">
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.15,0.1" GradientOrigin="0.15,0.1" RadiusX="0.9" RadiusY="0.7">
                        <GradientStop Color="#FF1E40AF" Offset="0"/>
                        <GradientStop Color="#001E40AF" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="1,1" GradientOrigin="1,1" RadiusX="0.7" RadiusY="0.6">
                        <GradientStop Color="#FF0369A1" Offset="0"/>
                        <GradientStop Color="#000369A1" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <DockPanel Margin="56,48">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="10" Background="White">
                        <ctl:Icon Data="{StaticResource Icon.Laptop}" Width="20" Height="20" Foreground="{StaticResource Brush.Side}"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TechGear" Foreground="White" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="Laptop &amp; Hardware Store" Foreground="#93A3BF" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="Đồ án UDQL2 2026 · Nhóm 23120068 · 23120069 · 23210078"
                           Foreground="#56647D" FontSize="12"/>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource Font.Display}" FontSize="40" FontWeight="SemiBold" Foreground="White" LineHeight="48">
                        <Run Text="Quản lý cửa hàng laptop"/><LineBreak/><Run Text="gọn gàng, rõ ràng, nhanh." Foreground="#93C5FD"/>
                    </TextBlock>
                    <TextBlock Text="Sản phẩm, tồn kho, đơn hàng, khách hàng và báo cáo doanh thu — tất cả trong một màn hình, kèm trợ lý AI tuân thủ phân quyền."
                               Foreground="#A5B1C6" FontSize="15" TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Left" Margin="0,16,0,0" LineHeight="24"/>

                    <StackPanel Orientation="Horizontal" Margin="0,34,0,0">
                        <StackPanel Margin="0,0,30,0">
                            <ctl:Icon Data="{StaticResource Icon.Box}" Width="22" Height="22" Foreground="#93C5FD" HorizontalAlignment="Left"/>
                            <TextBlock Text="Kho &amp; cấu hình" Foreground="White" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Text="CPU, RAM, GPU, tồn kho" Foreground="#7E8BA3" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,30,0">
                            <ctl:Icon Data="{StaticResource Icon.Cart}" Width="22" Height="22" Foreground="#93C5FD" HorizontalAlignment="Left"/>
                            <TextBlock Text="Bán hàng POS" Foreground="White" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Text="Kiểm tồn kho tức thì" Foreground="#7E8BA3" FontSize="12"/>
                        </StackPanel>
                        <StackPanel>
                            <ctl:Icon Data="{StaticResource Icon.Chart}" Width="22" Height="22" Foreground="#93C5FD" HorizontalAlignment="Left"/>
                            <TextBlock Text="Báo cáo &amp; AI" Foreground="White" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Text="Doanh thu, bán chạy" Foreground="#7E8BA3" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- Form đăng nhập -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="88,0" MaxWidth="440">
            <TextBlock Text="Đăng nhập" FontFamily="{StaticResource Font.Display}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,24"/>

            <TextBlock Text="Tên đăng nhập" Style="{StaticResource Text.Label}"/>
            <TextBox x:Name="TxtUsername" Text="{Binding LoginUsername, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" Margin="0,0,0,14"
                     ctl:Ui.Icon="{StaticResource Icon.User}" ctl:Ui.Placeholder="Nhập tên đăng nhập"/>

            <TextBlock Text="Mật khẩu" Style="{StaticResource Text.Label}"/>
            <PasswordBox x:Name="TxtPassword" MinHeight="44" Margin="0,0,0,18" ctl:Ui.Icon="{StaticResource Icon.Lock}"
                         PasswordChanged="TxtPassword_PasswordChanged"/>

            <TextBlock Text="Kiến trúc kết nối" Style="{StaticResource Text.Label}"/>
            <Border Background="#F1F5F9" CornerRadius="10" Padding="4" Margin="0,0,0,22">
                <UniformGrid Columns="2">
                    <RadioButton Style="{StaticResource Seg}" GroupName="LoginMode" Content="Direct Database · Giữa kỳ"
                                 ctl:Ui.Icon="{StaticResource Icon.Db}" IsChecked="{Binding IsDirectMode, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource Seg}" GroupName="LoginMode" Content="Web API · Cuối kỳ"
                                 ctl:Ui.Icon="{StaticResource Icon.Cloud}" IsChecked="{Binding IsApiMode, Mode=TwoWay}"/>
                </UniformGrid>
            </Border>

            <!-- Thông báo lỗi -->
            <Border Background="{StaticResource Brush.BadSoft}" CornerRadius="10" Padding="12,9" Margin="0,0,0,14"
                    Visibility="{Binding LoginError, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <ctl:Icon Data="{StaticResource Icon.Alert}" Width="15" Height="15" Foreground="{StaticResource Brush.BadInk}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding LoginError}" Foreground="{StaticResource Brush.BadInk}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="380"/>
                </StackPanel>
            </Border>

            <Button Command="{Binding LoginCommand}" Height="48" FontSize="14.5" HorizontalAlignment="Stretch" AutomationProperties.Name="Đăng nhập">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                        <Setter Property="Content" Value="Đăng nhập"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Content" Value="Đang đăng nhập…"/>
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>

<Window x:Class="LaptopStore.Client.Views.CreateOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Lập Đơn Hàng Bán Lẻ / Doanh Nghiệp" Height="700" Width="880"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="🧾 Lập Đơn Hàng Mới (Point of Sale)" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Chọn khách hàng, thêm laptop hoặc linh kiện vào đơn và xác nhận thanh toán" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Thông tin Khách hàng & Chọn sản phẩm thêm vào đơn -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <!-- Dòng 1: Khách hàng -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Khách hàng (*):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <ComboBox Grid.Row="0" Grid.Column="0" Margin="0,20,0,0" x:Name="CboCustomer" DisplayMemberPath="FullName" SelectedValuePath="Id" Padding="8,6" FontSize="13"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Thanh toán:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <ComboBox Grid.Row="0" Grid.Column="2" Margin="0,20,0,0" x:Name="CboPaymentMethod" Padding="8,6" FontSize="13"/>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="Giảm giá (VNĐ):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox Grid.Row="0" Grid.Column="4" Margin="0,20,0,0" x:Name="TxtDiscount" Text="0" Padding="8,6" FontSize="13" TextChanged="TxtDiscount_TextChanged"/>

                <!-- Dòng 2: Chọn sản phẩm & Số lượng & Nút Thêm -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Chọn Laptop / Linh kiện (*):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <ComboBox Grid.Row="2" Grid.Column="0" Margin="0,20,0,0" x:Name="CboProduct" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="8,6" FontSize="13" SelectionChanged="CboProduct_SelectionChanged"/>

                <TextBlock Grid.Row="2" Grid.Column="2" Text="Số lượng mua (*):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox Grid.Row="2" Grid.Column="2" Margin="0,20,0,0" x:Name="TxtQuantity" Text="1" Padding="8,6" FontSize="13"/>

                <Button Grid.Row="2" Grid.Column="4" Margin="0,20,0,0" Content="➕ Thêm vào đơn" Background="#2563EB" Foreground="White"
                        FontWeight="Bold" BorderThickness="0" Click="AddProductToCart_Click"/>
            </Grid>
        </Border>

        <!-- Bảng danh sách các mặt hàng trong đơn -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid x:Name="DgCartItems" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" Background="White" RowHeight="38">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã SKU" Binding="{Binding Sku}" Width="130"/>
                    <DataGridTextColumn Header="Tên Sản Phẩm" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Đơn Giá" Binding="{Binding UnitPrice, StringFormat={}{0:N0} đ}" Width="130"/>
                    <DataGridTextColumn Header="Số Lượng" Binding="{Binding Quantity}" Width="90"/>
                    <DataGridTextColumn Header="Thành Tiền" Binding="{Binding SubTotal, StringFormat={}{0:N0} đ}" Width="140" FontWeight="Bold"/>
                    <DataGridTemplateColumn Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="❌ Xóa" Padding="6,2" Background="#FEE2E2" Foreground="#DC2626" BorderThickness="0"
                                        FontSize="11" Click="RemoveItem_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Thông tin tính tiền & Ghi chú -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Địa chỉ & ghi chú -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Địa chỉ giao hàng (nếu có):" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,2"/>
                <TextBox x:Name="TxtShippingAddress" Padding="6,4" Margin="0,0,0,8" FontSize="12"/>

                <TextBlock Text="Ghi chú đơn hàng:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,2"/>
                <TextBox x:Name="TxtNote" Padding="6,4" FontSize="12"/>
            </StackPanel>

            <!-- Tổng kết tiền thanh toán -->
            <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Padding="14" BorderBrush="#CBD5E1" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Tổng tiền hàng:" Foreground="#64748B" FontSize="13"/>
                        <TextBlock x:Name="TxtTotalAmount" Text="0 đ" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Chiết khấu / Giảm giá:" Foreground="#64748B" FontSize="13"/>
                        <TextBlock x:Name="TxtDiscountDisplay" Text="0 đ" HorizontalAlignment="Right" Foreground="#EF4444" FontSize="13"/>
                    </DockPanel>
                    <Separator Margin="0,2,0,6"/>
                    <DockPanel>
                        <TextBlock Text="Khách cần trả:" FontWeight="Bold" FontSize="15" Foreground="#1E293B"/>
                        <TextBlock x:Name="TxtFinalAmount" Text="0 đ" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="#2563EB"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Nút thao tác -->
        <Border Grid.Row="4" Margin="0,14,0,0" Padding="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy bỏ" Padding="18,8" Margin="0,0,10,0" Background="#E2E8F0" Foreground="#334155"
                        BorderThickness="0" FontWeight="SemiBold" Click="CancelButton_Click"/>
                <Button Content="✅ Xác Nhận Lập Đơn Hàng" Padding="22,8" Background="#10B981" Foreground="White"
                        BorderThickness="0" FontWeight="Bold" FontSize="14" Click="ConfirmCreateOrder_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

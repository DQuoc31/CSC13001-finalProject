<Window x:Class="LaptopStore.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LaptopStore.Client.ViewModels"
        xmlns:views="clr-namespace:LaptopStore.Client.Views"
        mc:Ignorable="d"
        Title="TechGear Laptop Store - Hệ Thống Quản Lý Bán Hàng (Đồ Án UDQL2 2026 - MSSV: 23120078)"
        Height="780" Width="1240" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrdersViewModel}">
            <views:OrdersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AiAssistantViewModel}">
            <views:AiAssistantView/>
        </DataTemplate>

        <!-- Style cho Navigation Buttons -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 1. Thanh tiêu đề Header trên cùng -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,0">
            <DockPanel VerticalAlignment="Center">
                <!-- Tên cửa hàng & MSSV -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ TECHGEAR" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    <TextBlock Text="LAPTOP STORE" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="6,0,16,0"/>
                    <Border Background="#334155" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="MSSV: 23120078 | UDQL2 2026" Foreground="#94A3B8" FontSize="11"/>
                    </Border>
                </StackPanel>

                <!-- Thông tin đăng nhập & tài khoản demo nhanh -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Tài khoản demo buttons -->
                    <TextBlock Text="Đăng nhập Demo:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                    <Button Content="Admin" Margin="2,0" Padding="8,3" Background="#3B82F6" Foreground="White" BorderThickness="0" FontSize="11"
                            Command="{Binding QuickSelectAccountCommand}" CommandParameter="admin"/>
                    <Button Content="Manager" Margin="2,0" Padding="8,3" Background="#10B981" Foreground="White" BorderThickness="0" FontSize="11"
                            Command="{Binding QuickSelectAccountCommand}" CommandParameter="manager"/>
                    <Button Content="Staff" Margin="2,0" Padding="8,3" Background="#F59E0B" Foreground="White" BorderThickness="0" FontSize="11"
                            Command="{Binding QuickSelectAccountCommand}" CommandParameter="staff"/>
                    <Button Content="Warehouse" Margin="2,0" Padding="8,3" Background="#8B5CF6" Foreground="White" BorderThickness="0" FontSize="11"
                            Command="{Binding QuickSelectAccountCommand}" CommandParameter="warehouse"/>

                    <Button Content="🔑 Đăng Nhập" Margin="8,0,0,0" Padding="12,5" Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Command="{Binding LoginCommand}"/>

                    <!-- Thông tin user hiện tại -->
                    <Border Background="#334155" CornerRadius="6" Padding="10,4" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤 " Foreground="#38BDF8"/>
                            <TextBlock Text="{Binding UserDisplayName}" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text=" [" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Text="{Binding UserRoleName}" Foreground="#FDE047" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="]" Foreground="#94A3B8" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Phần thân giao diện: Sidebar bên trái & Content bên phải -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cột menu Sidebar -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="12,16">
                <DockPanel>
                    <!-- Danh mục chuyển trang -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="CHỨC NĂNG CHÍNH" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="8,0,0,8"/>

                        <Button Style="{StaticResource NavButtonStyle}" Content="💻 Quản Lý Sản Phẩm"
                                Command="{Binding NavigateProductsCommand}"/>

                        <Button Style="{StaticResource NavButtonStyle}" Content="📊 Báo Cáo Doanh Thu"
                                Command="{Binding NavigateDashboardCommand}"/>

                        <Button Style="{StaticResource NavButtonStyle}" Content="🧾 Quản Lý Đơn Hàng"
                                Command="{Binding NavigateOrdersCommand}"/>

                        <Button Style="{StaticResource NavButtonStyle}" Content="🤖 Trợ Lý AI Nghiệp Vụ"
                                Command="{Binding NavigateAiCommand}"/>
                    </StackPanel>

                    <!-- Khung thông tin hệ thống dưới góc sidebar -->
                    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" CornerRadius="8" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Kiến Trúc Hoạt Động" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                            <TextBlock Text="Client ➔ API Server ➔ SQLite/SQL Server" FontSize="10" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="Xác thực: JWT Bearer RBAC" FontSize="10" Foreground="#10B981" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Khung hiển thị nội dung chính -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
        </Grid>

        <!-- 3. Thanh trạng thái Status Bar dưới cùng -->
        <Border Grid.Row="2" Background="#0F172A" Padding="16,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage, TargetNullValue='Hệ thống sẵn sàng.'}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="Đồ án môn UDQL2 / Lập trình Desktop 2026 - Khoa CNTT" HorizontalAlignment="Right" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

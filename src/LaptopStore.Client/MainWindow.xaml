<Window x:Class="LaptopStore.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LaptopStore.Client.ViewModels"
        xmlns:views="clr-namespace:LaptopStore.Client.Views"
        xmlns:ctl="clr-namespace:LaptopStore.Client.Controls"
        mc:Ignorable="d"
        Title="TechGear Laptop Store"
        Height="900" Width="1440" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg}"
        FontFamily="{StaticResource Font.Text}" FontSize="13"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CategoriesViewModel}">
            <views:CategoriesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrdersViewModel}">
            <views:OrdersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AiAssistantViewModel}">
            <views:AiAssistantView/>
        </DataTemplate>

        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.SideMuted}"/>
            <Setter Property="Margin" Value="10,16,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ===================== Màn đăng nhập ===================== -->
        <views:LoginView Visibility="{Binding IsLoggedIn, Converter={StaticResource Vis}, ConverterParameter=invert}"/>

        <!-- ===================== Khung ứng dụng ===================== -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource Vis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Side}" ClipToBounds="True">
                <Grid>
                    <Ellipse Width="260" Height="260" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-90,-100,0" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#24FFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <DockPanel Margin="14,8,14,14">
                        <!-- Logo -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,12,0,12">
                            <Border Width="36" Height="36" CornerRadius="10" Background="White">
                                <ctl:Icon Data="{StaticResource Icon.Laptop}" Width="20" Height="20" Foreground="{StaticResource Brush.Side}"/>
                            </Border>
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="TechGear" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="Laptop Store" Foreground="{StaticResource Brush.SideSubtle}" FontSize="11.5"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Chân sidebar: kiến trúc kết nối + người dùng -->
                        <StackPanel DockPanel.Dock="Bottom">
                            <Border Background="{StaticResource Brush.SideHover}" BorderBrush="{StaticResource Brush.SideLine}" BorderThickness="1"
                                    CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Kiến trúc kết nối" FontSize="11" Foreground="{StaticResource Brush.SideSubtle}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Ellipse Width="7" Height="7" Fill="#4ADE80" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Online" FontSize="11" Foreground="{StaticResource Brush.SideSubtle}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Border Background="#38001A33" CornerRadius="8" Padding="3">
                                        <UniformGrid Columns="2">
                                            <RadioButton Style="{StaticResource Seg.Side}" GroupName="SideMode" Content="Direct DB"
                                                         ctl:Ui.Icon="{StaticResource Icon.Db}" IsChecked="{Binding IsDirectMode, Mode=TwoWay}"
                                                         ToolTip="Giữa kỳ: Ứng dụng ➔ Database Server"/>
                                            <RadioButton Style="{StaticResource Seg.Side}" GroupName="SideMode" Content="Web API"
                                                         ctl:Ui.Icon="{StaticResource Icon.Cloud}" IsChecked="{Binding IsApiMode, Mode=TwoWay}"
                                                         ToolTip="Cuối kỳ: Client ➔ API Server ➔ Database (cần chạy LaptopStore.Api)"/>
                                        </UniformGrid>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <TextBlock Text="App" FontSize="11" Foreground="{StaticResource Brush.SideSubtle}"/>
                                        <ctl:Icon Data="{StaticResource Icon.Right}" Width="11" Height="11" Margin="5,0" Foreground="{StaticResource Brush.SideSubtle}"/>
                                        <TextBlock Text="{Binding ConnectionFlow}" FontSize="11" Foreground="{StaticResource Brush.SideSubtle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Grid Margin="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentControl Width="34" Height="34" Content="{Binding UserDisplayName}" ContentTemplate="{StaticResource AvatarTemplate}"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UserDisplayName}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding UserRoleText}" Foreground="{StaticResource Brush.SideSubtle}" FontSize="11.5"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Width="32" Height="32" Padding="0"
                                        Foreground="{StaticResource Brush.SideSubtle}" ctl:Ui.Icon="{StaticResource Icon.Logout}"
                                        ToolTip="Đăng xuất" Command="{Binding LogoutCommand}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Điều hướng -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="TỔNG QUAN" Style="{StaticResource NavLabel}" Margin="10,12,0,8"/>
                                <Button Style="{StaticResource Btn.Nav}" Content="Bảng điều khiển" ctl:Ui.Icon="{StaticResource Icon.Dash}"
                                        Command="{Binding NavigateDashboardCommand}"
                                        Visibility="{Binding CanViewReports, Converter={StaticResource Vis}}"
                                        ctl:Ui.IsActive="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=dashboard}"/>
                                <Button Style="{StaticResource Btn.Nav}" Content="Trợ lý AI" ctl:Ui.Icon="{StaticResource Icon.Spark}"
                                        Command="{Binding NavigateAiCommand}"
                                        ctl:Ui.IsActive="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=ai}"/>

                                <TextBlock Text="BÁN HÀNG" Style="{StaticResource NavLabel}"/>
                                <Button Style="{StaticResource Btn.Nav}" Content="Bán hàng (POS)" ctl:Ui.Icon="{StaticResource Icon.Cart}"
                                        Command="{Binding NavigatePosCommand}"
                                        ctl:Ui.IsActive="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=pos}"/>
                                <Button Style="{StaticResource Btn.Nav}" Content="Đơn hàng" ctl:Ui.Icon="{StaticResource Icon.Receipt}" Tag="hot"
                                        Command="{Binding NavigateOrdersCommand}" ctl:Ui.Badge="{Binding PendingOrderCount}"
                                        ToolTip="Số đơn đang chờ xác nhận hoặc đang xử lý"
                                        ctl:Ui.IsActive="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=orders}"/>
                                <Button Style="{StaticResource Btn.Nav}" Content="Khách hàng" ctl:Ui.Icon="{StaticResource Icon.Users}"
                                        Command="{Binding NavigateCustomersCommand}" ctl:Ui.Badge="{Binding CustomerCount}"
                                        ctl:Ui.IsActive="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=customers}"/>

                                <TextBlock Text="KHO HÀNG" Style="{StaticResource NavLabel}"/>
                                <Button Style="{StaticResource Btn.Nav}" Content="Sản phẩm" ctl:Ui.Icon="{StaticResource Icon.Laptop}"
                                        Command="{Binding NavigateProductsCommand}" ctl:Ui.Badge="{Binding ProductCount}"
                                        ctl:Ui.IsActive="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=products}"/>
                                <Button Style="{StaticResource Btn.Nav}" Content="Danh mục" ctl:Ui.Icon="{StaticResource Icon.Folder}"
                                        Command="{Binding NavigateCategoriesCommand}" ctl:Ui.Badge="{Binding CategoryCount}"
                                        ctl:Ui.IsActive="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=categories}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Vùng nội dung -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- Thanh trên cùng -->
                <Border Grid.Row="0" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1" Padding="28,0">
                    <DockPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="TechGear" Foreground="{StaticResource Brush.Muted}" FontSize="12.5"/>
                            <ctl:Icon Data="{StaticResource Icon.Right}" Width="13" Height="13" Margin="6,0" Foreground="{StaticResource Brush.Muted}"/>
                            <TextBlock Text="{Binding PageTitle}" FontWeight="SemiBold" FontSize="12.5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <ctl:Icon Data="{StaticResource Icon.Clock}" Width="14" Height="14" Foreground="{StaticResource Brush.Faint}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding TodayText}" Foreground="{StaticResource Brush.Muted}" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Style="{StaticResource Btn.Primary}" Content="Tạo đơn" ctl:Ui.Icon="{StaticResource Icon.Plus}"
                                    Command="{Binding NavigatePosCommand}" ToolTip="Mở trang Bán hàng (POS)"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Trang hiện tại -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="28,22,28,24" Focusable="False"/>

                <!-- Thanh trạng thái -->
                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Padding="20,0">
                    <DockPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding ConnectionShort, StringFormat=Đã kết nối · {0}}" FontSize="11.5" Foreground="{StaticResource Brush.Muted}"/>
                            <TextBlock Text="{Binding CurrentView.StatusMessage}" FontSize="11.5" Foreground="{StaticResource Brush.Muted}" Margin="18,0,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="640"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock FontSize="11.5" Foreground="{StaticResource Brush.Muted}">
                                <Run Text="{Binding CurrentUser.Username, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding UserRoleText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="UDQL2 2026" FontSize="11.5" Foreground="{StaticResource Brush.Faint}" Margin="18,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
